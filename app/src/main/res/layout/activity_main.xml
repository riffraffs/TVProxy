<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="92"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/on_background"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/muted"
                android:textSize="16sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="128" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="92"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_tv"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_label"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_idle"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:id="@+id/pill_led"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/led_dot" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/status_idle"
                            android:textColor="@color/muted"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.08"
                    android:text="@string/lan_label"
                    android:textColor="@color/faint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lan_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/lan_unknown"
                    android:textColor="@color/on_background"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hint_dpad"
                android:textColor="@color/faint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="128"
            android:background="@drawable/card_tv"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="24dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/on_background"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_sub"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/protocol"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="22dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/row_tv"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/host"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_protocol"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/protocol_left"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_step"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_chevron_left"
                        android:tint="@color/step_arrow_tint" />

                    <TextView
                        android:id="@+id/protocol_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:duplicateParentState="true"
                        android:gravity="center"
                        android:minWidth="96dp"
                        android:text="@string/protocol_socks5"
                        android:textColor="@color/protocol_value"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/protocol_right"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_step"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/step_arrow_tint" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_host"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/row_tv"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_host"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/host"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="end|center_vertical"
                    android:hint="@string/hint_host"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLength="64"
                    android:nextFocusDown="@id/port"
                    android:nextFocusUp="@id/protocol"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/on_background"
                    android:textColorHighlight="@color/selection"
                    android:textColorHint="@color/faint"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_port"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/row_tv"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_port"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/port"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:digits="0123456789"
                    android:gravity="end|center_vertical"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:nextFocusDown="@id/btn_save"
                    android:nextFocusUp="@id/host"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/on_background"
                    android:textColorHighlight="@color/selection"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="12"
                android:scrollbars="vertical"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="14"
                    android:background="@drawable/btn_primary"
                    android:nextFocusDown="@id/btn_stop"
                    android:nextFocusRight="@id/btn_stop"
                    android:nextFocusUp="@id/port"
                    android:text="@string/btn_save_start"
                    android:textColor="@color/on_background"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="10"
                    android:background="@drawable/btn_secondary"
                    android:enabled="false"
                    android:nextFocusLeft="@id/btn_save"
                    android:nextFocusUp="@id/btn_save"
                    android:text="@string/btn_stop"
                    android:textColor="@color/on_background"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
